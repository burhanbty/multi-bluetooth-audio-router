<Window x:Class="MultiBluetoothAudioRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi Bluetooth Audio Router"
        Width="1100"
        Height="750"
        MinWidth="850"
        MinHeight="550"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <ScrollViewer x:Name="MainContentScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="True"
                  PanningMode="VerticalOnly">
      <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,20"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="Multi Bluetooth Audio Router" />

        <Border Grid.Row="1"
                Margin="0,0,0,20"
                Padding="14"
                Background="#FFF4D6"
                BorderBrush="#E2B84B"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="Recommended setup — Virtual Cable Mode" />
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="1. Set the Windows default audio output to VB-CABLE or another virtual audio cable." />
                <TextBlock Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="2. Select that virtual cable as Source Device in this application." />
                <TextBlock Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="3. Select your headphones or speakers as Output Device 1 and Output Device 2." />
                <TextBlock Margin="0,6,0,0"
                           FontStyle="Italic"
                           Foreground="#6B5500"
                           TextWrapping="Wrap"
                           Text="For safety, the source and outputs must be different devices, and both outputs must also be different from each other." />
                <TextBlock Margin="0,4,0,0"
                           FontStyle="Italic"
                           Foreground="#6B5500"
                           TextWrapping="Wrap"
                           Text="A virtual cable helps prevent feedback, but it cannot bypass a Bluetooth adapter that supports only one active A2DP audio stream." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Source Device" />
            <ComboBox x:Name="SourceDeviceComboBox"
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      MinHeight="34"
                      DisplayMemberPath="FriendlyName"
                      SelectionChanged="DeviceComboBox_SelectionChanged"
                      Tag="Source Device" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Output Device 1" />
            <ComboBox x:Name="OutputDevice1ComboBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      MinHeight="34"
                      DisplayMemberPath="FriendlyName"
                      SelectionChanged="DeviceComboBox_SelectionChanged"
                      Tag="Output Device 1" />

            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Output 1 Delay MS" />
            <Grid Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="Output1DelaySlider"
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="3000"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Value="0"
                        ValueChanged="DelaySlider_ValueChanged" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding ElementName=Output1DelaySlider, Path=Value, StringFormat={}{0:0} ms}" />
            </Grid>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Output Device 2" />
            <ComboBox x:Name="OutputDevice2ComboBox"
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      MinHeight="34"
                      DisplayMemberPath="FriendlyName"
                      SelectionChanged="DeviceComboBox_SelectionChanged"
                      Tag="Output Device 2" />

            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="Output 2 Delay MS" />
            <Grid Grid.Row="4"
                  Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="Output2DelaySlider"
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="3000"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Value="0"
                        ValueChanged="DelaySlider_ValueChanged" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding ElementName=Output2DelaySlider, Path=Value, StringFormat={}{0:0} ms}" />
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="12"
                Background="#EEF5FF"
                BorderBrush="#9ABBE8"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Manual latency calibration" />
                <TextBlock Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="If one device is heard earlier, add delay to that device. Wired devices usually need delay when paired with Bluetooth." />
                <TextBlock Margin="0,4,0,0"
                           FontStyle="Italic"
                           Foreground="#345A86"
                           TextWrapping="Wrap"
                           Text="Delay range: 0–3000 ms in 10 ms steps. Delay changes require stopping and restarting routing." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,20,0,20">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshDevicesButton"
                        Width="130"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="RefreshDevicesButton_Click"
                        Content="Refresh Devices" />
                <Button x:Name="StartRoutingButton"
                        Width="120"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="StartRoutingButton_Click"
                        Content="Start Routing" />
                <Button x:Name="StopRoutingButton"
                        Width="120"
                        Height="36"
                        Click="StopRoutingButton_Click"
                        Content="Stop Routing"
                        IsEnabled="False" />
            </StackPanel>

            <StackPanel Margin="0,10,0,0"
                        Orientation="Horizontal">
                <Button x:Name="StartFileTestButton"
                        Width="130"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="StartFileTestButton_Click"
                        Content="Start File Test" />
                <Button x:Name="StopFileTestButton"
                        Width="130"
                        Height="36"
                        Click="StopFileTestButton_Click"
                        Content="Stop File Test"
                        IsEnabled="False" />
            </StackPanel>

            <Button x:Name="HardwareDiagnosticButton"
                    Width="190"
                    Height="36"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Click="HardwareDiagnosticButton_Click"
                    Content="Hardware Diagnostic Test" />

            <Button x:Name="CalibrationClickButton"
                    Width="190"
                    Height="36"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Click="CalibrationClickButton_Click"
                    Content="Start Calibration Click Test" />

            <CheckBox x:Name="EnableFastPreflightCheckBox"
                      Margin="0,14,0,0"
                      IsChecked="True"
                      Content="Run fast compatibility preflight before routing" />

            <Border Margin="0,10,0,0"
                    Padding="10"
                    Background="#F3F8F3"
                    BorderBrush="#8DB58D"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Compatibility Assessment" />
                    <TextBlock x:Name="CompatibilityAssessmentTextBlock"
                               Margin="0,5,0,0"
                               Text="Compatibility: Not tested."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#3D5F3D"
                               Text="Alternatives: try Bluetooth + wired/USB, update Bluetooth/audio drivers, close Hands-Free or microphone apps, and check Windows LE Audio/Shared Audio support when available. A virtual cable cannot bypass an endpoint creation limit."
                               TextWrapping="Wrap" />
                    <Button x:Name="CopyDiagnosticReportButton"
                            Width="190"
                            Height="32"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="CopyDiagnosticReportButton_Click"
                            Content="Copy Diagnostic Report" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="5"
                Margin="0,0,0,16"
                Padding="10"
                Background="#F4F4F4"
                BorderBrush="#C8C8C8"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="Live route telemetry" />
                <TextBlock x:Name="RouteStatusTextBlock"
                           Margin="0,6,0,0"
                           FontFamily="Consolas"
                           Text="Routing telemetry: stopped."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="6"
                   Margin="0,0,0,8"
                   FontWeight="SemiBold"
                   Text="Log" />

        <TextBox x:Name="LogTextBox"
                 Grid.Row="7"
                 Height="260"
                 Margin="0,0,0,24"
                 Padding="10"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
      </Grid>
    </ScrollViewer>
</Window>
